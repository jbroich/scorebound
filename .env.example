# Copy this file to .env on the server. Never commit the populated .env file.
SCOREBOUND_DB_NAME=scorebound
SCOREBOUND_DB_USERNAME=scorebound
SCOREBOUND_DB_PASSWORD=replace-with-a-long-random-password

# Required for the first start only. Remove both values after the first admin
# has logged in and replaced the temporary password.
SCOREBOUND_BOOTSTRAP_ADMIN_USERNAME=admin
SCOREBOUND_BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-different-long-password

# The Cloudflare Tunnel should target this local listener.
SCOREBOUND_HTTP_BIND=127.0.0.1
SCOREBOUND_HTTP_PORT=8080
SCOREBOUND_SESSION_COOKIE_SECURE=true
SCOREBOUND_TIME_ZONE=Europe/Berlin

# Use a release or commit identifier when retaining several local image builds.
SCOREBOUND_IMAGE_TAG=local
